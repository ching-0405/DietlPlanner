<Window x:Class="NutritionPlannerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🍱 營養菜單設計系統 ｜ 熱量計算、食物代換與菜單設計"
        Icon="Assets/app.ico"
        Height="880" Width="1380" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>
    <!-- 全局視窗外層圓角陰影框 (提升軟體精緻度與可愛活潑現代感，外加邊距以便邊框縮放) -->
    <Border Background="#F4F6F8" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1.5" Margin="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/> <!-- Left Sidebar Navigation -->
                <ColumnDefinition Width="*"/>   <!-- Main Content Area -->
            </Grid.ColumnDefinitions>
            <!-- ========================================================= -->
            <!-- LEFT SIDEBAR NAVIGATION (深藍雅緻設計，完全依據使用者指定介面) -->
            <!-- ========================================================= -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" CornerRadius="12,0,0,12" BorderBrush="#111927" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Brand / Logo -->
                        <RowDefinition Height="Auto"/> <!-- Active Patient Mini Card -->
                        <RowDefinition Height="*"/>    <!-- 6 Navigation Tabs -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions & Tools -->
                    </Grid.RowDefinitions>
                    <!-- App Brand / Header (可拖曳移動視窗) -->
                    <Border Grid.Row="0" Padding="18,18,18,14" BorderBrush="#25354C" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Circular Avatar Logo with New Mascot / Illustration -->
                                <Border Width="46" Height="46" CornerRadius="23" Margin="0,0,12,0" BorderBrush="{StaticResource SidebarAccentBrush}" BorderThickness="2" ClipToBounds="True" Background="#FFF8EB">
                                    <Image Source="pack://application:,,,/Assets/app_icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="營養菜單設計系統" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="營養均衡 ｜ 健康每一天" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Active Patient Mini Card -->
                    <Border Grid.Row="1" Margin="12,12,12,6" Background="#141D2B" CornerRadius="10" Padding="12,10" BorderBrush="#2B3F5C" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="當前個案" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                                <Border Background="#2A9D8F" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right">
                                    <TextBlock Text="評估中" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="TxtActivePatientDisplay" Text="小明 (P001, 30歲 男)" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="目標熱量" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtActiveCaloriesDisplay" Text="2000 kcal" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SidebarAccentBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <!-- 6 Navigation Tabs (順序清晰：熱量營養素計算 → 食物代換表 → 菜單設計 → 菜單開立 → 管灌商業配方 → 營養成分) -->
                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <TextBlock Text="系統功能選單" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="16,0,0,6"/>
                        <RadioButton x:Name="NavBtnCalories" GroupName="SidebarNav" Style="{StaticResource SidebarNavRadio}" IsChecked="True" Click="NavBtnCalories_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="熱量營養素計算" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBtnFoodExchange" GroupName="SidebarNav" Style="{StaticResource SidebarNavRadio}" Click="NavBtnFoodExchange_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="食物代換表" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBtnMenuDesign" GroupName="SidebarNav" Style="{StaticResource SidebarNavRadio}" Click="NavBtnMenuDesign_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🍱" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="菜單設計" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBtnMenuRecipe" GroupName="SidebarNav" Style="{StaticResource SidebarNavRadio}" Click="NavBtnMenuRecipe_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📝" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="菜單開立" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBtnFormulas" GroupName="SidebarNav" Style="{StaticResource SidebarNavRadio}" Click="NavBtnFormulas_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🍼" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="管灌商業配方" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBtnNutritionSummary" GroupName="SidebarNav" Style="{StaticResource SidebarNavRadio}" Click="NavBtnNutritionSummary_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="營養成分總覽" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <!-- Bottom Quick Action Tools -->
                    <Border Grid.Row="3" Padding="12,10" BorderBrush="#25354C" BorderThickness="0,1,0,0" Background="#151E2B" CornerRadius="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快捷操作" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Button Content="➕ 新增個案" Style="{StaticResource CuteButtonBlue}" Margin="2" Padding="4,6" FontSize="11" Click="BtnNewClient_Click"/>
                                <Button Content="💾 儲存存檔" Style="{StaticResource CuteButtonGreen}" Margin="2" Padding="4,6" FontSize="11" Click="BtnSaveClient_Click"/>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <Button Content="🍼 配方庫" Style="{StaticResource CuteButtonAmber}" Margin="2" Padding="4,6" FontSize="11" Click="BtnOpenFormulas_Click"/>
                                <Button Content="🖨️ 衛教單" Style="{StaticResource CuteButton}" Margin="2" Padding="4,6" FontSize="11" Click="BtnExportReport_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <!-- ========================================================= -->
            <!-- MAIN CONTENT AREA (右側內容區) -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Header Title & Window Controls Bar -->
                    <RowDefinition Height="*"/>    <!-- Page Switcher (TabControl with hidden headers) -->
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                </Grid.RowDefinitions>
                <!-- TOP COMPACT RIBBON BAR (具備完整可拖曳區塊與視窗縮小/放大/關閉按鈕) -->
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10" CornerRadius="0,12,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Left Page Title -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPageHeaderTitle" Text="⚡ 熱量營養素計算" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock x:Name="TxtPageHeaderSubtitle" Text="包含基本資料、體位評估、三大營養素百分比試算、BEE/TDEE 與臨床速算對照表" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Middle Drag Hint Area -->
                        <Grid Grid.Column="1" Background="Transparent"/>
                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="➕ 新增個案" Style="{StaticResource CuteButtonBlue}" Margin="0,0,6,0" Padding="10,5" Click="BtnNewClient_Click"/>
                            <Button Content="💾 儲存個案" Style="{StaticResource CuteButtonGreen}" Margin="0,0,6,0" Padding="10,5" Click="BtnSaveClient_Click"/>
                            <Button Content="🍼 商業配方庫" Style="{StaticResource CuteButtonAmber}" Margin="0,0,6,0" Padding="10,5" Click="BtnOpenFormulas_Click"/>
                            <Button Content="🖨️ 匯出衛教單" Style="{StaticResource CuteButton}" Padding="10,5" Click="BtnExportReport_Click"/>
                        </StackPanel>
                        <!-- Window Control Buttons (縮小、最大化/還原、關閉) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- Minimize -->
                            <Button Width="32" Height="32" Margin="0,0,4,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click" ToolTip="最小化">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <TextBlock Text="━" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Maximize / Restore -->
                            <Button Width="32" Height="32" Margin="0,0,4,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnMaximize_Click" ToolTip="最大化 / 還原">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <TextBlock Text="🗖" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Close (紅色醒目) -->
                            <Button Width="32" Height="32" Background="#FEE2E2" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" ToolTip="關閉程式">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- MAIN PAGES SWITCHER (Header 隱藏，完全由左側選單控制切換) -->
                <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,10,12,6">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <!-- ========================================================= -->
                    <!-- PAGE 0: 熱量營養素計算 (體位基本資料 + 三大營養素百分比試算 + BEE/TDEE + 速算對照表) -->
                    <!-- ========================================================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Section 1: 基本資料與指標 -->
                                    <RowDefinition Height="Auto"/> <!-- Section 2: BEE/TDEE 與 臨床速算對照表 -->
                                    <RowDefinition Height="Auto"/> <!-- Section 3: 長照推定身高體重表 (收折/摺疊) -->
                                </Grid.RowDefinitions>
                                <!-- Section 1: 基本資料與指標評估 -->
                                <Border Grid.Row="0" Style="{StaticResource ExcelTableCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Background="{StaticResource ExcelGreenLightBrush}" Padding="12,8" Margin="-10,-10,-10,10" CornerRadius="8,8,0,0">
                                            <TextBlock Text="📋 個案基本資料與體位測量表 (身高、體重、BMI、IBW)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ExcelGreenBrush}"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Left Table: 基本輸入 -->
                                            <Border Grid.Column="0" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Background="White">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="34"/>
                                                        <RowDefinition Height="34"/>
                                                        <RowDefinition Height="34"/>
                                                        <RowDefinition Height="34"/>
                                                        <RowDefinition Height="34"/>
                                                        <RowDefinition Height="34"/>
                                                        <RowDefinition Height="34"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Row 0: 姓名 -->
                                                    <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                        <TextBlock Text="個案姓名 / 暱稱" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4">
                                                        <TextBox x:Name="InName" Text="小明" Style="{StaticResource ExcelCellInput}" TextChanged="OnInputParamChanged"/>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                                        <TextBlock Text="必填" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                                                    </Border>
                                                    <!-- Row 1: 病歷號 -->
                                                    <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                        <TextBlock Text="病歷號 / 編號" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4">
                                                        <TextBox x:Name="InChart" Text="P001" Style="{StaticResource ExcelCellInput}"/>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                                        <TextBlock Text="編號" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                                                    </Border>
                                                    <!-- Row 2: 生理性別 -->
                                                    <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                        <TextBlock Text="生理性別" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4">
                                                        <ComboBox x:Name="InGender" SelectedIndex="0" VerticalContentAlignment="Center" SelectionChanged="OnInputParamChanged">
                                                            <ComboBoxItem Content="男"/>
                                                            <ComboBoxItem Content="女"/>
                                                        </ComboBox>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                                        <TextBlock Text="男 / 女" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Row 3: 年齡 -->
                                                    <Border Grid.Row="3" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                        <TextBlock Text="年齡" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4">
                                                        <TextBox x:Name="InAge" Text="30" Style="{StaticResource ExcelCellInput}" TextChanged="OnInputParamChanged"/>
                                                    </Border>
                                                    <Border Grid.Row="3" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                                        <TextBlock Text="歲" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Row 4: 身高 -->
                                                    <Border Grid.Row="4" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                        <TextBlock Text="實際身高 (BH)" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4">
                                                        <TextBox x:Name="InHeight" Text="170" Style="{StaticResource ExcelCellInput}" TextChanged="OnInputParamChanged"/>
                                                    </Border>
                                                    <Border Grid.Row="4" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                                        <TextBlock Text="cm (公分)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Row 5: 實際體重 -->
                                                    <Border Grid.Row="5" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                        <TextBlock Text="實際體重 (BW)" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4">
                                                        <TextBox x:Name="InWeight" Text="68" Style="{StaticResource ExcelCellInput}" TextChanged="OnInputParamChanged"/>
                                                    </Border>
                                                    <Border Grid.Row="5" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                                        <TextBlock Text="kg (公斤)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Row 6: 理想體重 (移動至實際體重下方) -->
                                                    <Border Grid.Row="6" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0">
                                                        <TextBlock Text="理想體重 (IBW)" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="4" Background="#F0FDF4">
                                                        <TextBlock x:Name="LblIbwValue" Text="63.58 kg" FontWeight="Bold" FontSize="14" Foreground="#15803D" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Row="6" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,0" Padding="6,0">
                                                        <TextBlock Text="kg (公斤)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <!-- Right Side (Grid.Column="1"): 衍生體位指標計算結果 ＋ BMI指標表 (放在正常體重範圍的下方) -->
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <!-- 體位指標即時計算表 (BMI, IBW%, 正常體重範圍) -->
                                                <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="38"/>
                                                            <RowDefinition Height="38"/>
                                                            <RowDefinition Height="38"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="205"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="95"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Row 0: BMI -->
                                                        <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                            <TextBlock Text="BMI ＝ BW / BH²" VerticalAlignment="Center" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                            <TextBlock x:Name="LblBmiValue" Text="23.53" FontWeight="Bold" FontSize="16" Foreground="#E63946" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Row="0" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
                                                            <Border x:Name="BmiBadge" Background="#16A34A" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock x:Name="LblBmiStatus" Text="體重正常 (理想)" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                            </Border>
                                                        </Border>
                                                        <!-- Row 1: IBW% -->
                                                        <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                            <TextBlock Text="體重佔理想體重比 (IBW%)" VerticalAlignment="Center" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                            <TextBlock x:Name="LblIbwPercent" Text="106.9 %" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                                            <TextBlock Text="正常 90~110%" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                                                        </Border>
                                                        <!-- Row 2: 正常體重範圍 -->
                                                        <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0">
                                                            <TextBlock Text="正常體重範圍 (BMI 18.5~24)" VerticalAlignment="Center" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0">
                                                            <TextBlock x:Name="LblIbwRange" Text="53.4 ~ 69.3 kg" FontWeight="SemiBold" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Row="2" Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,0" Padding="6,0">
                                                            <TextBlock Text="標準區間" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- BMI 身體質量指數指標表：像量尺一樣連在一起無間隔，附尺標刻度與動態指針 (無數字) -->
                                                <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,8,0,0" Padding="10,8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📏 BMI 身體質量指數指標表" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                                                                <TextBlock Text="（體重 kg / 身高² m²）" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <!-- 尺型連續彩條 (5 色無縫連接，標註數值區間) -->
                                                        <Border BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="5" Margin="0,2,0,0" ClipToBounds="True">
                                                            <Grid Height="36">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- 1. 體重過輕 (< 18.5) -->
                                                                <Border x:Name="BmiSeg0" Grid.Column="0" Background="#0284C7" BorderBrush="White" BorderThickness="0,0,1,0">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="體重過輕" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="&lt; 18.5" FontWeight="SemiBold" Foreground="#E0F2FE" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- 2. 正常體重 (18.5 ~ 24) -->
                                                                <Border x:Name="BmiSeg1" Grid.Column="1" Background="#16A34A" BorderBrush="White" BorderThickness="0,0,1,0">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="正常體重" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="18.5 ~ 24" FontWeight="SemiBold" Foreground="#DCFCE7" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- 3. 體重過重 (24 ~ 27) -->
                                                                <Border x:Name="BmiSeg2" Grid.Column="2" Background="#EAB308" BorderBrush="White" BorderThickness="0,0,1,0">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="體重過重" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="24 ~ 27" FontWeight="SemiBold" Foreground="#FEF9C3" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- 4. 輕度肥胖 (27 ~ 30) -->
                                                                <Border x:Name="BmiSeg3" Grid.Column="3" Background="#F97316" BorderBrush="White" BorderThickness="0,0,1,0">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="輕度肥胖" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="27 ~ 30" FontWeight="SemiBold" Foreground="#FFEDD5" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- 5. 中重度肥胖 (≥ 30) -->
                                                                <Border x:Name="BmiSeg4" Grid.Column="4" Background="#EF4444">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="中重度肥胖" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="≥ 30" FontWeight="SemiBold" Foreground="#FEE2E2" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 尺標刻度列 (Ruler Ticks) -->
                                                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Height="14" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Column 0 ticks -->
                                                                <Grid Grid.Column="0">
                                                                    <Rectangle HorizontalAlignment="Left" Width="1.5" Height="12" Fill="#475569" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Margin="-24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Width="1" Height="8" Fill="#64748B" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Margin="24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Right" Width="1.5" Height="12" Fill="#475569" VerticalAlignment="Top"/>
                                                                </Grid>

                                                                <!-- Column 1 ticks -->
                                                                <Grid Grid.Column="1">
                                                                    <Rectangle HorizontalAlignment="Center" Margin="-24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Width="1" Height="8" Fill="#64748B" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Margin="24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Right" Width="1.5" Height="12" Fill="#475569" VerticalAlignment="Top"/>
                                                                </Grid>

                                                                <!-- Column 2 ticks -->
                                                                <Grid Grid.Column="2">
                                                                    <Rectangle HorizontalAlignment="Center" Margin="-24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Width="1" Height="8" Fill="#64748B" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Margin="24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Right" Width="1.5" Height="12" Fill="#475569" VerticalAlignment="Top"/>
                                                                </Grid>

                                                                <!-- Column 3 ticks -->
                                                                <Grid Grid.Column="3">
                                                                    <Rectangle HorizontalAlignment="Center" Margin="-24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Width="1" Height="8" Fill="#64748B" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Margin="24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Right" Width="1.5" Height="12" Fill="#475569" VerticalAlignment="Top"/>
                                                                </Grid>

                                                                <!-- Column 4 ticks -->
                                                                <Grid Grid.Column="4">
                                                                    <Rectangle HorizontalAlignment="Center" Margin="-24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Width="1" Height="8" Fill="#64748B" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Center" Margin="24,0,0,0" Width="1" Height="6" Fill="#94A3B8" VerticalAlignment="Top"/>
                                                                    <Rectangle HorizontalAlignment="Right" Width="1.5" Height="12" Fill="#475569" VerticalAlignment="Top"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 動態指針列：依據 BMI 數值即時精準滑動對位 (無固定五格置中限制) -->
                                                        <Canvas x:Name="CanvasBmiPointer" Height="28" Margin="0,2,0,0" ClipToBounds="False" SizeChanged="CanvasBmiPointer_SizeChanged">
                                                            <StackPanel x:Name="BmiDynamicPointer" Orientation="Vertical" HorizontalAlignment="Center" Width="70" Canvas.Left="0">
                                                                <TextBlock x:Name="TxtBmiArrow" Text="▲" FontSize="13" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                                                                <TextBlock x:Name="TxtBmiLabel" Text="個案指標" FontSize="11" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                            </StackPanel>
                                                        </Canvas>

                                                        <!-- 底部提示註記 -->
                                                        <TextBlock Text="※ 體脂、肌肉量等因素亦會影響評估，此表僅供參考。維持規律運動與均衡飲食，是保持健康體態的不二法門！" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,4,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Section 2: BEE/TDEE 與 臨床速算對照表 (並排呈現) -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- BEE/TDEE 表 -->
                                    <Border Grid.Column="1" Style="{StaticResource ExcelTableCard}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource HeaderBlueBrush}" Padding="10,6" Margin="-10,-10,-10,10" CornerRadius="8,8,0,0">
                                                <TextBlock Text="🔥 BEE 基礎代謝率 與 TDEE 每日熱量需求表" FontWeight="Bold" FontSize="14" Foreground="#1E40AF"/>
                                            </Border>
                                            <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="36"/>
                                                        <RowDefinition Height="36"/>
                                                        <RowDefinition Height="36"/>
                                                        <RowDefinition Height="40"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Row 0: BEE -->
                                                    <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="BEE 基本熱量 (HB公式)" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                                                        <TextBlock x:Name="LblBeeValue" Text="1544 kcal" FontWeight="Bold" FontSize="15" Foreground="#E63946" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Row 1: 活動因子 -->
                                                    <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="活動因子 (Activity)" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                        <ComboBox x:Name="CboActivityFactor" SelectionChanged="OnFactorChanged" VerticalContentAlignment="Center">
                                                            <ComboBoxItem Content="臥床 (1.2)" Tag="1.2"/>
                                                            <ComboBoxItem Content="輕度活動 - 久坐/上班族 (1.3)" Tag="1.3" IsSelected="True"/>
                                                            <ComboBoxItem Content="中度活動 - 站立工作/運動習慣 (1.4)" Tag="1.4"/>
                                                            <ComboBoxItem Content="重度活動 - 勞動工作者/運動員 (1.6)" Tag="1.6"/>
                                                        </ComboBox>
                                                    </Border>
                                                    <!-- Row 2: 壓力因子 -->
                                                    <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="壓力因子 (Stress)" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                                                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                        <ComboBox x:Name="CboStressFactor" SelectionChanged="OnFactorChanged" VerticalContentAlignment="Center">
                                                            <ComboBoxItem Content="正常無壓力 (1.0)" Tag="1.0" IsSelected="True"/>
                                                            <ComboBoxItem Content="輕度飢餓 (0.85)" Tag="0.85"/>
                                                            <ComboBoxItem Content="小手術或癌症 (1.2)" Tag="1.2"/>
                                                            <ComboBoxItem Content="腹膜炎 (1.15)" Tag="1.15"/>
                                                            <ComboBoxItem Content="骨折、骨骼創傷 (1.3)" Tag="1.3"/>
                                                            <ComboBoxItem Content="發燒 1°F (1.07)" Tag="1.07"/>
                                                            <ComboBoxItem Content="發燒 1°C (1.13)" Tag="1.13"/>
                                                            <ComboBoxItem Content="生長 (1.4)" Tag="1.4"/>
                                                            <ComboBoxItem Content="懷孕 (1.1)" Tag="1.1"/>
                                                            <ComboBoxItem Content="哺乳 (1.4)" Tag="1.4"/>
                                                            <ComboBoxItem Content="敗血 (1.8)" Tag="1.8"/>
                                                            <ComboBoxItem Content="燒傷 30% (1.7)" Tag="1.7"/>
                                                            <ComboBoxItem Content="燒傷 50% (2.0)" Tag="2.0"/>
                                                            <ComboBoxItem Content="燒傷 70% (2.2)" Tag="2.2"/>
                                                        </ComboBox>
                                                    </Border>
                                                    <!-- Row 3: TDEE 結果與套用按鈕 -->
                                                    <Border Grid.Row="3" Grid.Column="0" Background="#F0FDF4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0"><TextBlock Text="TDEE 每日熱量需求" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center"/></Border>
                                                    <Border Grid.Row="3" Grid.Column="1" Background="#F0FDF4" Padding="8,4">
                                                        <DockPanel>
                                                            <TextBlock x:Name="LblTdeeValue" Text="2007 kcal" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center"/>
                                                            <Button Content="✨ 套用為目標熱量" Style="{StaticResource CuteButtonGreen}" HorizontalAlignment="Right" Padding="8,4" Click="BtnApplyTdeeAsTarget_Click"/>
                                                        </DockPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <!-- 臨床速算熱量對照表 -->
                                    <Border Grid.Column="0" Style="{StaticResource ExcelTableCard}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource HeaderYellowBrush}" Padding="10,6" Margin="-10,-10,-10,10" CornerRadius="8,8,0,0">
                                                <TextBlock Text="⚡ 臨床速算熱量對照表 (點擊直接套用為目標熱量)" FontWeight="Bold" FontSize="14" Foreground="#B45309"/>
                                            </Border>
                                            <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="28"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                                                        <TextBlock Text="點選下方數值按鈕，可直接快速帶入上方目標熱量" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- IBW 速算欄 -->
                                                    <StackPanel Grid.Row="1" Margin="8,6,8,4">
                                                        <TextBlock Text="📌 理想體重 (IBW) 速算：" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                                        <UniformGrid Columns="2">
                                                            <Button x:Name="BtnIbw25" Content="IBW x 25 = 1590 kcal" Style="{StaticResource CuteButtonBlue}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnIbw28" Content="IBW x 28 = 1780 kcal" Style="{StaticResource CuteButtonBlue}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnIbw30" Content="IBW x 30 = 1907 kcal" Style="{StaticResource CuteButtonBlue}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnIbw35" Content="IBW x 35 = 2225 kcal" Style="{StaticResource CuteButtonBlue}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                    <!-- CBW 速算欄 -->
                                                    <StackPanel Grid.Row="2" Margin="8,4,8,8">
                                                        <TextBlock Text="📌 實際體重 (CBW) 速算：" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                                        <UniformGrid Columns="2">
                                                            <Button x:Name="BtnCbw25" Content="CBW x 25 = 1700 kcal" Style="{StaticResource CuteButtonAmber}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnCbw28" Content="CBW x 28 = 1904 kcal" Style="{StaticResource CuteButtonAmber}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnCbw30" Content="CBW x 30 = 2040 kcal" Style="{StaticResource CuteButtonAmber}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnCbw35" Content="CBW x 35 = 2380 kcal" Style="{StaticResource CuteButtonAmber}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnCbw40" Content="CBW x 40 = 2720 kcal" Style="{StaticResource CuteButtonAmber}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                            <Button x:Name="BtnCbw45" Content="CBW x 45 = 3060 kcal" Style="{StaticResource CuteButtonAmber}" Margin="2" Padding="4,4" FontSize="11" Click="BtnQuickCalorie_Click"/>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Section 3: 臨床腎功能推估與行動不便推估公式 -->
                                <Border Grid.Row="2" Style="{StaticResource ExcelTableCard}">
                                    <StackPanel>
                                        <Border Background="#F1F5F9" Padding="10,6" Margin="-10,-10,-10,8" CornerRadius="8,8,0,0">
                                            <TextBlock Text="📐 臨床腎功能推估與行動不便推估公式 (肌酸酐、eGFR、膝長、尺骨長、圍度推算)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDarkBrush}"/>
                                        </Border>
                                        <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="推估項目" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="測量輸入數值" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="2" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="推估公式說明" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="3" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="推估結果" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="4" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0"><TextBlock Text="操作狀態" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <!-- Row 1: 肌酸酐與 eGFR -->
                                                <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="🧪 血清肌酸酐 / eGFR" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="肌酸酐：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBox x:Name="InCreatinine" Text="0.9" Width="60" Style="{StaticResource ExcelCellInput}" TextChanged="OnInputParamChanged"/>
                                                        <TextBlock Text=" mg/dL" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="CKD-EPI 腎絲球過濾率公式" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/></Border>
                                                <Border Grid.Row="1" Grid.Column="3" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LblEgfrValue" Text="105.3" FontWeight="Bold" FontSize="13" Foreground="#2A9D8F"/>
                                                        <TextBlock Text=" ml/min" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                                                    <Border x:Name="EgfrBadge" Background="#38B000" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LblEgfrStage" Text="G1 正常" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Border>
                                                <!-- Row 2: 膝長推算身高 -->
