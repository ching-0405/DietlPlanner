                                                    <DataGridTextColumn Header="脂肪(g/份)" Binding="{Binding FatPerUnit, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" FontWeight="SemiBold" Foreground="#D97706" Width="100"/>
                                                    <DataGridTextColumn Header="醣類(g/份)" Binding="{Binding CarbPerUnit, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" FontWeight="SemiBold" Foreground="#E63946" Width="100"/>
                                                    <DataGridTextColumn Header="熱量(kcal/份)" Binding="{Binding CaloriesPerUnit, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" FontWeight="Bold" Foreground="#1E40AF" Width="110"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <!-- Bottom Reference Note -->
                                            <Border Background="{StaticResource HeaderBlueBrush}" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="💡 說明：" FontWeight="Bold" Foreground="#1E40AF" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="此食物代換表即時連動全系統！切換至【菜單設計】分頁即可分配六餐份數。" FontSize="11" Foreground="#334155"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <!-- Right: 國健署每日飲食指南扇形圖與健康原則 -->
                                    <Border Grid.Column="1" Style="{StaticResource ExcelTableCard}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource HeaderYellowBrush}" Padding="12,8" Margin="-10,-10,-10,8" CornerRadius="8,8,0,0">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="🥗 每日飲食指南扇形圖" FontSize="14" FontWeight="Bold" Foreground="#B45309"/>
                                                    <TextBlock Text="國民健康署均衡飲食六大類食物代換原則" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Image of Food Guide -->
                                            <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="8" Background="White" Padding="6" HorizontalAlignment="Center">
                                                <Image Source="pack://application:,,,/Assets/food_guide.jpg" Stretch="Uniform" MaxHeight="380" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <!-- Key Principles Summary -->
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="🎯 均衡飲食三大口訣：" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="1. 全穀雜糧為主食，未精製全穀佔 1/3 以上" FontSize="11" Foreground="#475569" Margin="0,1"/>
                                                    <TextBlock Text="2. 豆魚蛋肉適量吃，先豆再魚後蛋肉" FontSize="11" Foreground="#475569" Margin="0,1"/>
                                                    <TextBlock Text="3. 蔬果彩虹原則，多色深綠與當季水果" FontSize="11" Foreground="#475569" Margin="0,1"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ========================================================= -->
                    <!-- PAGE 2: 菜單設計 (天然食物六餐分配與即時小計) -->
                    <!-- ========================================================= -->
                    <TabItem>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top Action Header -->
                                <RowDefinition Height="*"/>    <!-- 6-Meal Food Exchanges Grid + Summary Rows -->
                            </Grid.RowDefinitions>

                            <!-- Top Action Header -->
                            <Border Grid.Row="0" Style="{StaticResource ExcelTableCard}" Padding="10,8" Margin="4,0,4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🍱 菜單飲食份數設計" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}"/>
                                        <TextBlock Text="（直接點選各欄位輸入份數，熱量與三大營養素即時加總）" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="BtnDiabeticDietTab2" Content="糖尿病、低蛋白飲食" Style="{StaticResource CuteButtonBlue}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnToggleDiabeticDiet_Click"/>
                                        <Button Content="➕ 新增自訂食物" Style="{StaticResource CuteButtonBlue}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnAddFoodExchange_Click"/>
                                        <Button Content="🔄 份數歸零" Style="{StaticResource CuteButtonAmber}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnClearExchanges_Click"/>
                                        <Button Content="🌟 載入 2000 kcal 均衡菜單範例" Style="{StaticResource CuteButtonGreen}" Padding="10,4" FontSize="11" Click="BtnPresetSampleDiet_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Food Exchanges Grid (早餐、早點、午餐、午點、晚餐、晚點、實際份數) -->
                            <Border Grid.Row="1" Style="{StaticResource ExcelTableCard}" Padding="2" Margin="4,0,4,4">
                                <Grid VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Food Exchanges Grid (早餐、早點、午餐、午點、晚餐、晚點、實際份數) -->
                                    <DataGrid x:Name="GridExchanges" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                                              GridLinesVisibility="All" HeadersVisibility="Column"
                                              BorderThickness="0,0,0,1" BorderBrush="{StaticResource CellBorderBrush}"
                                              Background="White" RowHeight="32"
                                              CellEditEnding="GridExchanges_CellEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="食物類別" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Width="135"/>

                                            <!-- 飲食份數 Ex 與對應三大營養素與熱量 -->
                                            <DataGridTextColumn Header="份數 Ex" Binding="{Binding ActualPortions, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" FontWeight="Bold" Foreground="#3A86FF" Width="90"/>
                                            <DataGridTextColumn Header="蛋白質(g)" Binding="{Binding ActualProtein, StringFormat='{}{0:0.#}'}" IsReadOnly="True" FontWeight="SemiBold" Foreground="{StaticResource ExcelGreenBrush}" Width="85"/>
                                            <DataGridTextColumn Header="脂質(g)" Binding="{Binding ActualFat, StringFormat='{}{0:0.#}'}" IsReadOnly="True" FontWeight="SemiBold" Foreground="#D97706" Width="85"/>
                                            <DataGridTextColumn Header="醣類(g)" Binding="{Binding ActualCarbs, StringFormat='{}{0:0.#}'}" IsReadOnly="True" FontWeight="SemiBold" Foreground="#E63946" Width="85"/>
                                            <DataGridTextColumn Header="熱量(kcal)" Binding="{Binding ActualCalories, StringFormat='{}{0:0.#}'}" IsReadOnly="True" FontWeight="Bold" Foreground="#3A86FF" Width="95"/>

                                            <!-- 建議飲食 6 餐分配 -->
                                            <DataGridTextColumn Header="早餐" Binding="{Binding Breakfast, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="60"/>
                                            <DataGridTextColumn Header="早點" Binding="{Binding MorningSnack, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="60"/>
                                            <DataGridTextColumn Header="午餐" Binding="{Binding Lunch, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="60"/>
                                            <DataGridTextColumn Header="午點" Binding="{Binding AfternoonSnack, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="60"/>
                                            <DataGridTextColumn Header="晚餐" Binding="{Binding Dinner, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="60"/>
                                            <DataGridTextColumn Header="晚點" Binding="{Binding NightSnack, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="60"/>
                                            <DataGridTextColumn Header="建議小計" Binding="{Binding SuggestedTotalPortions, StringFormat='{}{0:0.##}'}" IsReadOnly="True" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 堅果種子下方第一列：三大營養素加總克數 (與上方欄位完全對齊) -->
                                    <Grid Grid.Row="1" Height="34" Background="#F8FAFC">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 食物類別 -->
                                        <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0">
                                            <TextBlock Text="三大營養素加總克數" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- 份數 Ex -->
                                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeActualPortions" Text="0" FontWeight="Bold" Foreground="#3A86FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 蛋白質(g) -->
                                        <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeActualProt" Text="0.0 g" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 脂質(g) -->
                                        <Border Grid.Column="3" Background="#FFFBEB" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeActualFat" Text="0.0 g" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 醣類(g) -->
                                        <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeActualCarb" Text="0.0 g" FontWeight="Bold" Foreground="#E63946" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 熱量(kcal) -->
                                        <Border Grid.Column="5" Background="#EFF6FF" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeActualKcal" Text="0 kcal" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 早餐 -->
                                        <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="2,0">
                                            <TextBlock x:Name="LblMealBfSum" Text="0" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 早點 -->
                                        <Border Grid.Column="7" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="2,0">
                                            <TextBlock x:Name="LblMealMsSum" Text="0" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 午餐 -->
                                        <Border Grid.Column="8" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="2,0">
                                            <TextBlock x:Name="LblMealLuSum" Text="0" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 午點 -->
                                        <Border Grid.Column="9" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="2,0">
                                            <TextBlock x:Name="LblMealAsSum" Text="0" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 晚餐 -->
                                        <Border Grid.Column="10" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="2,0">
                                            <TextBlock x:Name="LblMealDiSum" Text="0" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 晚點 -->
                                        <Border Grid.Column="11" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="2,0">
                                            <TextBlock x:Name="LblMealNsSum" Text="0" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 建議小計 -->
                                        <Border Grid.Column="12" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="2,0">
                                            <TextBlock x:Name="LblMealTotalSum" Text="0" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 填滿剩餘空白 -->
                                        <Border Grid.Column="13" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1"/>
                                    </Grid>

                                    <!-- 堅果種子下方第二列：三大營養素百分比 (與上方欄位完全對齊) -->
                                    <Grid Grid.Row="2" Height="34" Background="#F8FAFC">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 食物類別 -->
                                        <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0">
                                            <TextBlock Text="三大營養素百分比" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- 份數 Ex -->
                                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                                            <TextBlock Text="—" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 蛋白質(%) -->
                                        <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeProtRatio" Text="0.0 %" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 脂質(%) -->
                                        <Border Grid.Column="3" Background="#FFFBEB" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeFatRatio" Text="0.0 %" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 醣類(%) -->
                                        <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeCarbRatio" Text="0.0 %" FontWeight="Bold" Foreground="#E63946" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 熱量百分比 -->
                                        <Border Grid.Column="5" Background="#EFF6FF" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                                            <TextBlock x:Name="LblExchangeRatioTotal" Text="100 %" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 右側區間呈現 4-9-4 快速計算過程與公式 -->
                                        <Border Grid.Column="6" Grid.ColumnSpan="8" Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,0" Padding="8,0">
                                            <DockPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="LblExchangeMacroFormulaBreakdown" Text="4-9-4熱量：醣 0g×4 (0 kcal) ＋ 蛋 0g×4 (0 kcal) ＋ 脂 0g×9 (0 kcal) ＝ 0 kcal" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LblExchangeCalcKcalFormula" Text="0 kcal" FontWeight="Bold" FontSize="12" Foreground="#B45309" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <!-- ========================================================= -->
                    <!-- PAGE 3: 菜單開立 (食物代換智慧查詢 ＋ 菜單開立 ＋ AI 食材顏色智慧辨識) -->
                    <!-- ========================================================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4">
                                <!-- 2. 菜單開立功能主體 -->
                                <Border Style="{StaticResource ExcelTableCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Top Action Header -->
                                        <Border Background="{StaticResource HeaderPinkBrush}" Padding="12,10" Margin="-10,-10,-10,8" CornerRadius="8,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#E63946" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                                        <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="菜單開立 ＆ AI 食材顏色智慧辨識" FontSize="15" FontWeight="Bold" Foreground="#E63946"/>
                                                        <TextBlock Text="相同菜名自動合併顯示 ｜ AI 自動辨識食材純色膠囊標籤（橙、黃、紅、綠、紫/黑、白、棕）" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- 餐次切換選單與當前餐次規劃份數提示 -->
                                                    <Button Content="📖 衛福部食物代換表查詢" Style="{StaticResource CuteButtonBlue}" Padding="10,5" Margin="0,0,12,0" FontSize="11" Click="BtnOpenFoodExchangeQuery_Click"/>
                                                    <TextBlock Text="預設餐次：" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <ComboBox x:Name="CboDefaultMealTime" SelectedIndex="0" VerticalAlignment="Center" Width="95" Margin="0,0,8,0" Padding="6,4" SelectionChanged="CboDefaultMealTime_SelectionChanged">
                                                        <ComboBoxItem Content="全部餐次"/>
                                                        <ComboBoxItem Content="早餐"/>
                                                        <ComboBoxItem Content="早點"/>
                                                        <ComboBoxItem Content="午餐"/>
                                                        <ComboBoxItem Content="午點"/>
                                                        <ComboBoxItem Content="晚餐"/>
                                                        <ComboBoxItem Content="晚點"/>
                                                    </ComboBox>
                                                    <Border x:Name="PnlCurrentMealTarget" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="依據【菜單設計】設定之該餐次食物份數">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🎯 本餐規劃：" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TxtCurrentMealTargetPortions" Text="載入中..." FontSize="11" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Content="➕ 新增菜色食材" Style="{StaticResource CuteButtonBlue}" Padding="10,5" Margin="0,0,6,0" Click="BtnAddMenuItem_Click"/>
                                                    <Button Content="🌟 載入經典範例菜單" Style="{StaticResource CuteButtonGreen}" Padding="10,5" Margin="0,0,6,0" Click="BtnLoadSampleMenuRecipe_Click"/>
                                                    <Button Content="🗑️ 清空所有菜單" Style="{StaticResource CuteButtonAmber}" Padding="10,5" Click="BtnClearMenuRecipe_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- 各餐次菜單設計份數即時對照列 -->
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📌 各餐次設計份數對照（依據「菜單設計」即時連動）：" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                                                        <TextBlock Text="點選餐次卡片可快速切換開立餐次" FontSize="11" Foreground="#64748B" Margin="6,1,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <!-- 6 個餐次規劃份數卡片 -->
                                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                                    <!-- 早餐 -->
                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,4" Cursor="Hand" Tag="早餐" MouseLeftButtonUp="MealCard_Click" ToolTip="點選切換為早餐">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🌅 早餐：" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11"/>
                                                            <TextBlock x:Name="TxtBreakfastTarget" Text="未設定" FontWeight="SemiBold" Foreground="#1E40AF" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 早點 -->
                                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,4" Cursor="Hand" Tag="早點" MouseLeftButtonUp="MealCard_Click" ToolTip="點選切換為早點">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🍎 早點：" FontWeight="Bold" Foreground="#B45309" FontSize="11"/>
                                                            <TextBlock x:Name="TxtMorningSnackTarget" Text="未設定" FontWeight="SemiBold" Foreground="#92400E" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 午餐 -->
                                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,4" Cursor="Hand" Tag="午餐" MouseLeftButtonUp="MealCard_Click" ToolTip="點選切換為午餐">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🍱 午餐：" FontWeight="Bold" Foreground="#15803D" FontSize="11"/>
                                                            <TextBlock x:Name="TxtLunchTarget" Text="未設定" FontWeight="SemiBold" Foreground="#166534" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 午點 -->
                                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,4" Cursor="Hand" Tag="午點" MouseLeftButtonUp="MealCard_Click" ToolTip="點選切換為午點">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🥪 午點：" FontWeight="Bold" Foreground="#B45309" FontSize="11"/>
                                                            <TextBlock x:Name="TxtAfternoonSnackTarget" Text="未設定" FontWeight="SemiBold" Foreground="#92400E" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 晚餐 -->
                                                    <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,4" Cursor="Hand" Tag="晚餐" MouseLeftButtonUp="MealCard_Click" ToolTip="點選切換為晚餐">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🍲 晚餐：" FontWeight="Bold" Foreground="#7E22CE" FontSize="11"/>
                                                            <TextBlock x:Name="TxtDinnerTarget" Text="未設定" FontWeight="SemiBold" Foreground="#6B21A8" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 晚點 -->
                                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,4" Cursor="Hand" Tag="晚點" MouseLeftButtonUp="MealCard_Click" ToolTip="點選切換為晚點">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🥛 晚點：" FontWeight="Bold" Foreground="#475569" FontSize="11"/>
                                                            <TextBlock x:Name="TxtNightSnackTarget" Text="未設定" FontWeight="SemiBold" Foreground="#334155" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Menu Detail DataGrid (相同菜名合併、去除圓點純色膠囊標籤) -->
                                        <DataGrid x:Name="GridMenuRecipe" AutoGenerateColumns="False" CanUserAddRows="True"
                                                  GridLinesVisibility="All" HeadersVisibility="Column"
                                                  BorderThickness="1" BorderBrush="{StaticResource CellBorderBrush}" Background="White" RowHeight="36" MinHeight="250" MaxHeight="450"
                                                  CellEditEnding="GridMenuRecipe_CellEditEnding">
                                            <DataGrid.Columns>
                                                <!-- 餐次欄位 (早餐、早點、午餐、午點、晚餐、晚點) -->
                                                <DataGridTemplateColumn Header="餐次" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MealTime}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="12" HorizontalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox SelectedValue="{Binding MealTime, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" VerticalAlignment="Center">
                                                                <ComboBoxItem Content="早餐"/>
                                                                <ComboBoxItem Content="早點"/>
                                                                <ComboBoxItem Content="午餐"/>
                                                                <ComboBoxItem Content="午點"/>
                                                                <ComboBoxItem Content="晚餐"/>
                                                                <ComboBoxItem Content="晚點"/>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                <!-- 菜名欄位 (若與上一列相同菜名則透明並合併顯示) -->
                                                <DataGridTemplateColumn Header="菜名" Width="180">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" Padding="8,0" BorderBrush="{StaticResource CellBorderBrush}" SnapsToDevicePixels="True">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLastInDishGroup}" Value="False">
                                                                                <!-- 非該道菜最後一列：覆蓋底部分隔線以呈現垂直合併視覺 -->
                                                                                <Setter Property="Margin" Value="0,0,0,-1"/>
                                                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                                                <Setter Property="BorderBrush" Value="#F8FAFC"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding DishName}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFirstInDishGroup}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding DishName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExcelCellInput}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="食材" Binding="{Binding IngredientName, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" Foreground="#1E293B" Width="180"/>
                                                <DataGridTextColumn Header="食物類別" Binding="{Binding Category, UpdateSourceTrigger=LostFocus}" Width="130"/>
                                                <DataGridTextColumn Header="份數 (Ex)" Binding="{Binding ExchangePortion, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##} Ex'}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Width="110"/>
                                                <DataGridTextColumn Header="生重克數 (g)" Binding="{Binding RawWeightGrams, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.#} g'}" FontWeight="SemiBold" Width="120"/>
                                                <!-- AI 自動辨識食材顏色標籤 (去除前面的 ● 圓點，純色圓角膠囊排版) -->
                                                <DataGridTemplateColumn Header="食材顏色" Width="170">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="12" Padding="14,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding ColorHex}"/>
                                                                </Border.Background>
                                                                <TextBlock Text="{Binding FoodColor}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ColorHex}" Value="#D5E8B3">
                                                                                    <Setter Property="Foreground" Value="#2D3748"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ColorHex}" Value="#A8D878">
                                                                                    <Setter Property="Foreground" Value="#1F2937"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ColorHex}" Value="#F8F9FA">
                                                                                    <Setter Property="Foreground" Value="#2D3748"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="烹調與備註" Binding="{Binding Notes, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                                <DataGridTemplateColumn Header="操作" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕ 刪除" Style="{StaticResource CuteButton}" Background="#EF4444" Padding="6,2" FontSize="10" Click="BtnDeleteMenuItem_Click" Tag="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Bottom AI Color Statistics Card (色彩豐富度與植化素指引) -->
                                <Border Background="{StaticResource HeaderYellowBrush}" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🌈 五色蔬果色彩評估：" FontWeight="Bold" Foreground="#B45309" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="LblColorCountStats" Text="已開立食材色彩統計：紅、綠、黃、白、橙、黑" FontSize="12" Foreground="#334155"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="💡 營養指引：每日菜單涵蓋多種天然食材顏色，可攝取多元植化素與抗氧化抗發炎營養！" FontSize="11" Foreground="#78350F" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ========================================================= -->
                    <!-- PAGE 4: 管灌商業配方 (獨立分頁：配方份數規劃、單份規格、即時總計) -->
                    <!-- ========================================================= -->
                    <TabItem>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top Action Header -->
                                <RowDefinition Height="*"/>    <!-- Commercial Formulas Grid -->
                                <RowDefinition Height="Auto"/> <!-- Commercial Formula Subtotal Bar -->
                            </Grid.RowDefinitions>
                            <!-- Top Action Header -->
                            <Border Grid.Row="0" Style="{StaticResource ExcelTableCard}" Padding="12,10" Margin="4,0,4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource HeaderYellowBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="🍼" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="管灌商業營養配方計算專區" FontSize="15" FontWeight="Bold" Foreground="#B45309"/>
                                            <TextBlock Text="可針對特殊醫療、管灌或營養補充個案規劃【建議份數】與【實際份數】，熱量與營養素即時併入全日總量！" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="⚙️ 管理商業配方資料庫" Style="{StaticResource CuteButtonAmber}" Padding="10,5" Click="BtnOpenFormulas_Click"/>
                                </Grid>
                            </Border>
                            <!-- Commercial Formulas Grid -->
                            <Border Grid.Row="1" Style="{StaticResource ExcelTableCard}" Padding="2" Margin="4,0,4,8">
                                <DataGrid x:Name="GridFormulasPlanner" AutoGenerateColumns="False" CanUserAddRows="False"
                                          GridLinesVisibility="All" HeadersVisibility="Column"
                                          BorderThickness="0" Background="White" RowHeight="32"
                                          CellEditEnding="GridFormulasPlanner_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="商業配方品名" Binding="{Binding Name}" IsReadOnly="True" FontWeight="Bold" Width="160"/>
                                        <DataGridTextColumn Header="包裝規格" Binding="{Binding Spec}" IsReadOnly="True" Foreground="#718096" Width="130"/>
                                        <DataGridTextColumn Header="單份熱量" Binding="{Binding Calories, StringFormat='{}{0:0.#} kcal'}" IsReadOnly="True" Width="95"/>
                                        <DataGridTextColumn Header="蛋白質" Binding="{Binding Protein, StringFormat='{}{0:0.#} g'}" IsReadOnly="True" Width="80"/>
                                        <DataGridTextColumn Header="脂肪" Binding="{Binding Fat, StringFormat='{}{0:0.#} g'}" IsReadOnly="True" Width="75"/>
                                        <DataGridTextColumn Header="醣類" Binding="{Binding Carbs, StringFormat='{}{0:0.#} g'}" IsReadOnly="True" Width="75"/>
                                        <!-- 建議飲食份數 -->
                                        <DataGridTextColumn Header="【建議份數】" Binding="{Binding SuggestedPortions, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.#}'}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Width="105"/>
                                        <DataGridTextColumn Header="建議熱量小計" Binding="{Binding SuggestedTotalCalories, StringFormat='{}{0:0.#} kcal'}" IsReadOnly="True" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}" Width="110"/>
                                        <!-- 實際飲食份數 -->
                                        <DataGridTextColumn Header="份數 Ex" Binding="{Binding ActualPortions, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" FontWeight="Bold" Foreground="#3A86FF" Width="90"/>
                                        <DataGridTextColumn Header="實際熱量小計" Binding="{Binding ActualTotalCalories, StringFormat='{}{0:0.#} kcal'}" IsReadOnly="True" Width="110"/>
                                        <DataGridTextColumn Header="用途說明" Binding="{Binding Notes}" IsReadOnly="True" Foreground="#718096" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <!-- Commercial Formula Subtotal Bar -->
                            <Border Grid.Row="2" Background="{StaticResource HeaderYellowBrush}" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="4,0,4,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="【商業配方建議小計】： " FontWeight="Bold" Foreground="#B45309" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="蛋白質：" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="LblFormulaTotalProt" Text="0 g" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="脂肪：" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="LblFormulaTotalFat" Text="0 g" FontWeight="Bold" Foreground="#D97706" Margin="0,0,12,0"/>
                                    <TextBlock Text="醣類：" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="LblFormulaTotalCarb" Text="0 g" FontWeight="Bold" Foreground="#E63946" Margin="0,0,12,0"/>
                                    <TextBlock Text="配方總熱量：" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="LblFormulaTotalKcal" Text="0 kcal" FontWeight="Bold" FontSize="14" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <!-- ========================================================= -->
                    <!-- PAGE 5: 營養成分 (全方位總對照表、營養師衛教建議、台灣食品營養成分資料庫) -->
                    <!-- ========================================================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Summary Comparison Table -->
                                    <RowDefinition Height="Auto"/> <!-- Notes & Export -->
                                    <RowDefinition Height="Auto"/> <!-- 台灣食品營養成分資料庫 2025版 UPDATE1 -->
                                </Grid.RowDefinitions>
                                <!-- Summary Comparison Table (Excel 格狀總表) -->
                                <Border Grid.Row="0" Style="{StaticResource ExcelTableCard}">
                                    <StackPanel>
                                        <Border Background="{StaticResource ExcelGreenLightBrush}" Padding="10,6" Margin="-10,-10,-10,10" CornerRadius="8,8,0,0">
                                            <TextBlock Text="🎯 目標熱量 vs 建議菜單總計 vs 實際飲食攝取 (全方位營養成分對照表)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ExcelGreenBrush}"/>
                                        </Border>
                                        <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="32"/>
                                                    <RowDefinition Height="36"/>
                                                    <RowDefinition Height="36"/>
                                                    <RowDefinition Height="36"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Header -->
                                                <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="評估維度" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="總熱量 (kcal)" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="2" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="三大營養素分配 (醣 / 蛋 / 脂)" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="3" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="熱量百分比比例 (%)" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="4" Background="#F1F5F9" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0"><TextBlock Text="狀態 / 達成率" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <!-- Row 1: 目標 -->
                                                <Border Grid.Row="1" Grid.Column="0" Background="#FFF5F5" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="🎯 目標規劃" FontWeight="Bold" Foreground="#E63946" VerticalAlignment="Center"/></Border>
                                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock x:Name="LblDashTargetKcal" Text="2000 kcal" FontWeight="Bold" FontSize="15" Foreground="#E63946" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock x:Name="LblDashTargetMacros" Text="醣 250g ｜ 蛋 100g ｜ 脂 67g" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="1" Grid.Column="3" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock x:Name="LblRatioTargetText" Text="50% / 20% / 30%" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border>
                                                <Border Grid.Row="1" Grid.Column="4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0"><TextBlock Text="基準目標" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <!-- Row 2: 建議菜單 -->
                                                <Border Grid.Row="2" Grid.Column="0" Background="#F0FDF4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock Text="🍱 建議菜單 (食物+配方)" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center"/></Border>
                                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock x:Name="LblDashSuggestedKcal" Text="1980 kcal" FontWeight="Bold" FontSize="15" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="2" Grid.Column="2" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock x:Name="LblDashSuggestedMacros" Text="醣 248g ｜ 蛋 98g ｜ 脂 65g" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="2" Grid.Column="3" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,1" Padding="8,0"><TextBlock x:Name="LblRatioSuggestedText" Text="50% / 20% / 30%" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/></Border>
                                                <Border Grid.Row="2" Grid.Column="4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0"><TextBlock x:Name="LblDashAchievementRate" Text="達成率 99.0%" FontWeight="Bold" Foreground="{StaticResource ExcelGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <!-- Row 3: 實際飲食 -->
                                                <Border Grid.Row="3" Grid.Column="0" Background="#EBF8FF" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0"><TextBlock Text="🍽️ 目前實際飲食" FontWeight="Bold" Foreground="#2B6CB0" VerticalAlignment="Center"/></Border>
                                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0"><TextBlock x:Name="LblDashActualKcal" Text="1520 kcal" FontWeight="Bold" FontSize="15" Foreground="#2B6CB0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="3" Grid.Column="2" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0"><TextBlock x:Name="LblDashActualMacros" Text="醣 190g ｜ 蛋 65g ｜ 脂 55g" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="3" Grid.Column="3" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,1,0" Padding="8,0"><TextBlock x:Name="LblRatioActualText" Text="50% / 17% / 33%" Foreground="#2B6CB0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/></Border>
                                                <Border Grid.Row="3" Grid.Column="4" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,0" Padding="8,0"><TextBlock x:Name="LblDashActualDiff" Text="差距 -480 kcal" FontWeight="Bold" Foreground="#E63946" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <!-- Notes & Export -->
                                <Border Grid.Row="1" Style="{StaticResource ExcelTableCard}" Margin="0,8,0,8">
                                    <StackPanel>
                                        <TextBlock Text="📝 營養師衛教備註與生活建議" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource ExcelCellInput}" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="6"
                                                 Text="建議每日分三正餐與兩次健康點心；補充足夠水分 2000ml；若血糖偏高注意米食精製澱粉替換為全穀雜糧。"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="💡 提示：點擊右上方「💾 儲存個案」可隨時存入 SQLite 資料庫。" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            <Button Content="🖨️ 產生並列印衛教處方單" Style="{StaticResource CuteButton}" HorizontalAlignment="Right" Click="BtnExportReport_Click"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 台灣食品營養成分資料庫 (2025版 UPDATE1) 表格 (取代原病歷號/編號歷史資料庫) -->
                                <Border Grid.Row="2" Style="{StaticResource ExcelTableCard}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <Border Background="{StaticResource HeaderBlueBrush}" Padding="12,8" Margin="-10,-10,-10,8" CornerRadius="8,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#2563EB" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                                        <TextBlock Text="📗" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="台灣食品營養成分資料庫 (2025版 UPDATE1)" FontSize="14" FontWeight="Bold" Foreground="#1E40AF"/>
                                                        <TextBlock Text="衛生福利部最新食品成分檢索表 ｜ 每 100g 可食部分之完整營養成分規格" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 搜尋與篩選工具列 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="快速搜尋：" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="TxtCompositionSearch" Width="170" Height="30" Padding="6,4" FontSize="12" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" TextChanged="TxtCompositionSearch_TextChanged"
                                                             ToolTip="輸入食品名稱、俗名、整合編號，例如：糙米、雞胸肉、小薏仁、A0100101"/>
                                                    <ComboBox x:Name="CboCompositionCategoryFilter" Width="140" Height="30" Margin="6,0,0,0" VerticalContentAlignment="Center" SelectionChanged="CboCompositionCategoryFilter_SelectionChanged">
                                                         <ComboBoxItem Content="全部類別" IsSelected="True"/>
                                                         <ComboBoxItem Content="穀物類"/>
                                                         <ComboBoxItem Content="澱粉類"/>
                                                         <ComboBoxItem Content="堅果及種子類"/>
                                                         <ComboBoxItem Content="豆類"/>
                                                         <ComboBoxItem Content="蔬菜類"/>
                                                         <ComboBoxItem Content="菇類"/>
                                                         <ComboBoxItem Content="藻類"/>
                                                         <ComboBoxItem Content="水果類"/>
                                                         <ComboBoxItem Content="肉類"/>
                                                         <ComboBoxItem Content="魚貝類"/>
                                                         <ComboBoxItem Content="蛋類"/>
                                                         <ComboBoxItem Content="乳品類"/>
                                                         <ComboBoxItem Content="油脂類"/>
                                                         <ComboBoxItem Content="糖類"/>
                                                         <ComboBoxItem Content="飲料類"/>
                                                         <ComboBoxItem Content="糕餅點心類"/>
                                                         <ComboBoxItem Content="加工調理食品及其他類"/>
                                                         <ComboBoxItem Content="調味料及香辛料類"/>
                                                    </ComboBox>
                                                    <Button Content="❌ 清除" Style="{StaticResource CuteButtonAmber}" Padding="8,4" Margin="6,0,0,0" Click="BtnClearCompositionSearch_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 筆數統計與提示 -->
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock x:Name="LblCompositionStats" Text="📋 共收錄 2,213 筆台灣官方食品營養成分資料" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                                <TextBlock Text="💡 數值單位：每 100 g 可食部分之含量 ｜ 點選欄位標題可進行正反排序" FontSize="11" Foreground="#166534" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- 食品營養成分 DataGrid -->
                                        <DataGrid x:Name="GridFoodComposition" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  GridLinesVisibility="All" HeadersVisibility="Column"
                                                  BorderThickness="1" BorderBrush="{StaticResource CellBorderBrush}"
                                                  Background="White" RowHeight="32" MaxHeight="450" IsReadOnly="True"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                  EnableRowVirtualization="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="整合編號" Binding="{Binding Code}" FontWeight="Bold" Foreground="#475569" Width="95"/>
                                                <DataGridTextColumn Header="食品分類" Binding="{Binding Category}" FontWeight="SemiBold" Foreground="#2563EB" Width="105"/>
                                                <DataGridTextColumn Header="樣品名稱" Binding="{Binding Name}" FontWeight="Bold" Foreground="#1E293B" Width="150"/>
                                                <DataGridTextColumn Header="俗名" Binding="{Binding CommonName}" Foreground="#64748B" Width="140"/>
                                                <DataGridTextColumn Header="熱量 (kcal)" Binding="{Binding Calories, StringFormat='{}{0:0.#}'}" FontWeight="Bold" Foreground="#E63946" Width="90"/>
                                                <DataGridTextColumn Header="粗蛋白 (g)" Binding="{Binding Protein, StringFormat='{}{0:0.#}'}" FontWeight="SemiBold" Foreground="{StaticResource ExcelGreenBrush}" Width="90"/>
                                                <DataGridTextColumn Header="粗脂肪 (g)" Binding="{Binding Fat, StringFormat='{}{0:0.#}'}" FontWeight="SemiBold" Foreground="#D97706" Width="90"/>
                                                <DataGridTextColumn Header="飽和脂肪 (g)" Binding="{Binding SaturatedFat, StringFormat='{}{0:0.#}'}" Width="95"/>
                                                <DataGridTextColumn Header="總碳水 (g)" Binding="{Binding Carbs, StringFormat='{}{0:0.#}'}" FontWeight="SemiBold" Foreground="#2A9D8F" Width="90"/>
                                                <DataGridTextColumn Header="膳食纖維 (g)" Binding="{Binding DietaryFiber, StringFormat='{}{0:0.#}'}" Width="95"/>
                                                <DataGridTextColumn Header="糖質總量 (g)" Binding="{Binding Sugars, StringFormat='{}{0:0.#}'}" Width="95"/>
                                                <DataGridTextColumn Header="水分 (g)" Binding="{Binding Water, StringFormat='{}{0:0.#}'}" Width="80"/>
                                                <DataGridTextColumn Header="鈉 (mg)" Binding="{Binding Sodium, StringFormat='{}{0:0.#}'}" Width="80"/>
                                                <DataGridTextColumn Header="鉀 (mg)" Binding="{Binding Potassium, StringFormat='{}{0:0.#}'}" Width="80"/>
                                                <DataGridTextColumn Header="鈣 (mg)" Binding="{Binding Calcium, StringFormat='{}{0:0.#}'}" Width="80"/>
                                                <DataGridTextColumn Header="鐵 (mg)" Binding="{Binding Iron, StringFormat='{}{0:0.#}'}" Width="80"/>
                                                <DataGridTextColumn Header="膽固醇 (mg)" Binding="{Binding Cholesterol, StringFormat='{}{0:0.#}'}" Width="95"/>
                                                <DataGridTextColumn Header="內容物描述" Binding="{Binding Description}" Foreground="#64748B" Width="200"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <!-- STATUS BAR -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6" CornerRadius="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStatus" Text="✨ 系統就緒 ｜ 菜單開立、AI食材顏色辨識與管灌配方獨立分頁 ｜ 數值即時連動計算" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="🥗 膳食設計系統 菜單設計 v2.1 ｜ 輕量單機版" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
