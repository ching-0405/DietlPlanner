<Window x:Class="NutritionPlannerApp.FormulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🍼 商業營養配方資料庫管理" Height="620" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryLightBrush}" CornerRadius="14" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🍼" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="商業營養配方庫 (可自訂新增、編輯熱量與營養素)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    <TextBlock Text="此處儲存於本機 SQLite 資料庫，設計菜單時可即時選用" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Edit Form -->
        <Border Grid.Row="1" Style="{StaticResource CuteCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                    <TextBlock Text="配方品名*" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtName" Style="{StaticResource CuteTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <TextBlock Text="包裝規格 (如 250ml/罐)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtSpec" Style="{StaticResource CuteTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                    <TextBlock Text="蛋白質 (g)*" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtProtein" Text="0" Style="{StaticResource CuteTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                    <TextBlock Text="脂肪 (g)*" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtFat" Text="0" Style="{StaticResource CuteTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="4">
                    <TextBlock Text="醣類 (g)*" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtCarbs" Text="0" Style="{StaticResource CuteTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="5" Margin="4">
                    <TextBlock Text="熱量 (kcal)*" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtCalories" Text="0" Style="{StaticResource CuteTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Margin="4,8,4,4">
                    <TextBlock Text="特色說明/適用病症 (如 糖尿病適用、洗腎專用)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtNotes" Style="{StaticResource CuteTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="6" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="BtnSave" Content="💾 儲存配方" Style="{StaticResource CuteButtonMatcha}" Margin="0,0,0,8" Click="BtnSave_Click"/>
                    <Button x:Name="BtnClearForm" Content="🔄 清空欄位" Style="{StaticResource CuteButtonAmber}" Click="BtnClearForm_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid of Formulas -->
        <Border Grid.Row="2" Style="{StaticResource CuteCard}" Padding="8">
            <DataGrid x:Name="GridFormulas" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent" SelectionMode="Single"
                      RowHeight="34" SelectionChanged="GridFormulas_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="配方名稱" Binding="{Binding Name}" Width="160" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="規格包裝" Binding="{Binding Spec}" Width="130"/>
                    <DataGridTextColumn Header="蛋白質 (g)" Binding="{Binding Protein}" Width="90"/>
                    <DataGridTextColumn Header="脂肪 (g)" Binding="{Binding Fat}" Width="85"/>
                    <DataGridTextColumn Header="醣類 (g)" Binding="{Binding Carbs}" Width="85"/>
                    <DataGridTextColumn Header="熱量 (kcal)" Binding="{Binding Calories}" Width="95"/>
                    <DataGridTextColumn Header="備註說明" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTemplateColumn Header="操作" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️ 刪除" Style="{StaticResource CuteButton}"
                                        Background="#EF233C" Padding="6,2" FontSize="11"
                                        Click="BtnDeleteRow_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="💡 提示：點擊列表中的項目可載入上方進行修改，點擊刪除可移除該配方。"
                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✔️ 完成關閉" Style="{StaticResource CuteButton}" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
